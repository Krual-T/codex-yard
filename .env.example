# npm start reads .env. Copy this file and set only the values you need.
PORT=8765

# Keep the service behind a private network or an authenticated HTTPS proxy.
# AGENTS_PUBLIC_ORIGIN=https://workbench.example.com
# AGENTS_WORKSPACE=/path/to/projects
# AGENTS_DATA_DIR=/path/to/private/workbench-data
# CODEX_HOME=/path/to/.codex
# AGENTS_CODEX_BIN=/path/to/codex
# A custom socket connects directly; otherwise npm start starts/reuses the CLI daemon.
# AGENTS_CODEX_SOCKET=/path/to/app-server-control.sock
# Optional override; by default use vendor/native-app-tools/26.1013.40934/server.mjs.
# AGENTS_APP_TOOLS_ADAPTER=/path/to/native-app-tools/server.mjs

# Optional: use your own proxy when direct external requests fail.
# HTTPS_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1
