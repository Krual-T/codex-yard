# npm start reads .env. Copy this file and set only the values you need.
PORT=8765

# Keep the service behind a private network or an authenticated HTTPS proxy.
# AGENTS_PUBLIC_ORIGIN=https://workbench.example.com
# A local node's https://<machine>.<tailnet>.ts.net:<port> also enables automatic
# loopback development previews using Tailscale Serve. See docs/development-previews.md.
# Optional: let these trusted Yard origins embed this instance (for development previews).
# Exact HTTP/HTTPS origins, space-separated. This grants UI control to the embedding site.
# AGENTS_EMBEDDING_ORIGINS="http://127.0.0.1:8765 https://workbench.example.com:8765"
# AGENTS_WORKSPACE=/path/to/projects
# AGENTS_DATA_DIR=/path/to/private/workbench-data
# CODEX_HOME=/path/to/.codex
# AGENTS_CODEX_BIN=/path/to/codex
# A custom socket connects directly; otherwise npm start starts/reuses the CLI daemon.
# AGENTS_CODEX_SOCKET=/path/to/app-server-control.sock
# Optional override; by default use vendor/native-app-tools/26.1013.40934/server.mjs.
# AGENTS_APP_TOOLS_ADAPTER=/path/to/native-app-tools/server.mjs

# Optional Web Push VAPID contact; keys and subscriptions stay in AGENTS_DATA_DIR.
# Defaults to the Codex Yard project URL. Use an HTTPS URL or a mailto: contact.
# YARD_WEB_PUSH_SUBJECT=mailto:you@example.com

# Original Node REPL uses the independent Node running Yard and Codex CLI.
# Override only with independently prepared runtimes, never App installation paths.
# YARD_NODE_REPL_ROOT=/absolute/path/to/original-runtime/linux-x64
# YARD_NODE_REPL_NODE=/absolute/path/to/independent/node

# Optional original Computer Use: selected local X11 desktop and its accessibility bus.
# The computer-use plugin supplies lifecycle hooks; see docs/standalone-plugins.md.
# YARD_COMPUTER_DISPLAY=:0
# YARD_COMPUTER_XAUTHORITY=/path/to/.Xauthority
# DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# AT_SPI_BUS=unix:path=/path/to/selected/accessibility/bus

# Optional original in-app Browser: independent Chromium, started lazily by Yard.
# YARD_BROWSER_EXECUTABLE=/absolute/path/to/chromium
# YARD_BROWSER_HEADLESS=true

# WSL controlling the Windows desktop: independently installed Windows Node/CLI.
# YARD_COMPUTER_TARGET=windows
# YARD_WINDOWS_NODE="C:\Program Files\nodejs\node.exe"
# YARD_WINDOWS_SKY_PIPE=\\.\pipe\codex-yard-computer-use
# YARD_WINDOWS_CODEX_BIN="C:\path\to\standalone\codex.exe"
# YARD_CHROME_WINDOWS=true
# Optional pipe selector when multiple Chrome extension profiles are connected.
# YARD_CHROME_WINDOWS_PIPE=\\.\pipe\codex-browser-use-...

# Optional additional original Chrome/Browser backend sockets (platform path delimiter).
# YARD_BROWSER_BACKEND_PATHS=/absolute/path/to/independent/backend.sock

# Original file runtime defaults to ~/.local/share/codex-yard/artifact-runtime.
# Set this in actual execution tools, or pass its path to plugin/runtime.ts.
# A running Codex daemon does not inherit a change made only in this file.
# YARD_ARTIFACT_RUNTIME_MANIFEST=/absolute/private/runtime/runtime.json

# Optional: use your own proxy when direct external requests fail.
# HTTPS_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1
