{
  "name": "computer-use",
  "version": "0.7.8+yard.2",
  "description": "Original Sky desktop API through the standalone node_repl runtime",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "node_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${session_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "node_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${agent_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "node_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${session_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ]
    }
  }
}
