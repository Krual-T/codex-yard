{
  "name": "codex-yard",
  "version": "0.2.0",
  "private": true,
  "description": "A browser workspace for local and SSH Codex sessions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "build": "npm run build:host",
    "build:host": "node scripts/build-native.ts",
    "typecheck": "tsc --noEmit",
    "thread:title": "node scripts/set-thread-title.ts",
    "tools:configure": "node --env-file-if-exists=.env scripts/configure-native-tools.ts",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.local/chrome.env --use-env-proxy src/native/server.ts",
    "pretest": "npm run build:host",
    "test": "node --test --test-concurrency=2 test/*.test.mjs test/*.test.ts",
    "test:app-tools": "node --test test/app-tools.test.mjs",
    "pretest:plugins:cli": "npm run build:host",
    "test:plugins:cli": "node scripts/verify-plugins.ts --ui",
    "pretest:computer:cli": "npm run build:host",
    "test:computer:cli": "node scripts/verify-computer.ts",
    "browser:poc": "node scripts/browser-reuse-poc.ts",
    "pretest:embedded-browser:ui": "npm run build:host",
    "test:embedded-browser:ui": "node scripts/verify-embedded-browser.ts",
    "test:queue": "node --use-env-proxy scripts/verify-queue.ts",
    "test:model-settings": "node --use-env-proxy scripts/verify-model-settings.ts",
    "test:model-providers:ui": "node --use-env-proxy scripts/verify-model-providers.ts",
    "test:visual": "node --use-env-proxy scripts/verify-visual-feedback.ts",
    "test:visualizations": "node --use-env-proxy scripts/verify-visualizations.ts",
    "test:tabs:ui": "node --use-env-proxy scripts/verify-workspace-tabs.ts",
    "pretest:previews:ui": "npm run build:host",
    "test:previews:ui": "node scripts/verify-file-previews.ts",
    "pretest:file-paste:ui": "npm run build:host",
    "test:file-paste:ui": "node scripts/verify-file-paste.ts",
    "test:tablet:ui": "node --use-env-proxy scripts/verify-tablet-sidebar.ts",
    "test:mobile-input:ui": "node --use-env-proxy scripts/verify-mobile-input.ts",
    "test:sidebar-copy-models:ui": "node --use-env-proxy scripts/verify-sidebar-copy-models.ts",
    "pretest:sidebar-toggle:ui": "npm run build:host",
    "test:sidebar-toggle:ui": "node scripts/verify-sidebar-toggle.ts",
    "pretest:startup:ui": "npm run build:host",
    "test:startup:ui": "node scripts/verify-sidebar-startup.ts --check-empty",
    "test:host-preferences:ui": "node --use-env-proxy scripts/verify-host-preferences.ts",
    "pretest:history:ui": "npm run build:host",
    "test:history:ui": "node scripts/verify-conversation-history.ts",
    "pretest:history:cli": "npm run build:host",
    "test:history:cli": "node scripts/verify-conversation-history-cli.ts",
    "pretest:read-state:cli": "npm run build:host",
    "test:read-state:cli": "node scripts/verify-thread-read-state.ts",
    "pretest:sidebar-state:cli": "npm run build:host",
    "test:sidebar-state:cli": "node scripts/verify-sidebar-state.ts",
    "pretest:sidebar-state:ui": "npm run build:host",
    "test:sidebar-state:ui": "node scripts/verify-sidebar-state-ui.ts",
    "pretest:sidechat:cli": "npm run build:host",
    "test:sidechat:cli": "node scripts/verify-sidechat-threads.ts",
    "pretest:sidebar-legacy:ui": "npm run build:host",
    "test:sidebar-legacy:ui": "node scripts/verify-sidebar-legacy-ui.ts",
    "pretest:state-convergence:ui": "npm run build:host",
    "test:state-convergence:ui": "node scripts/verify-state-convergence.ts",
    "pretest:turn-progress:ui": "npm run build:host",
    "test:turn-progress:ui": "node scripts/verify-turn-progress.ts",
    "pretest:port-forwarding:ui": "npm run build:host",
    "test:port-forwarding:ui": "node scripts/verify-port-forwarding.ts",
    "pretest:automations:ui": "npm run build:host",
    "test:automations:ui": "node scripts/verify-automations.ts",
    "pretest:automations:cli": "npm run build:host",
    "test:automations:cli": "node scripts/verify-automation-cli.ts --ui",
    "test:new-chat:ui": "node --use-env-proxy scripts/verify-new-chat.ts",
    "pretest:send:ui": "npm run build:host",
    "test:send:ui": "node scripts/verify-message-submission.ts",
    "test:terminal:ui": "node --use-env-proxy scripts/verify-terminal.ts",
    "pretest:notifications:ui": "npm run build:host",
    "test:notifications:ui": "node scripts/verify-notifications.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "2.8.1",
    "web-push": "4.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "chrome-devtools-mcp": "1.12.0",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2",
    "typescript": "5.9.3"
  }
}
