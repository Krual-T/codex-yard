{
  "name": "codex-yard",
  "version": "0.2.0",
  "private": true,
  "description": "A browser workspace for local and SSH Codex sessions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "build": "npm run build:host",
    "build:host": "node scripts/build-native.ts",
    "typecheck": "tsc --noEmit",
    "thread:title": "node scripts/set-thread-title.ts",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.local/chrome.env --use-env-proxy src/native/server.ts",
    "pretest": "npm run build:host",
    "test": "node --test test/*.test.mjs test/*.test.ts",
    "test:app-tools": "node --test test/app-tools.test.mjs",
    "browser:poc": "node scripts/browser-reuse-poc.ts",
    "test:browser-reuse": "node --use-env-proxy scripts/verify-browser-reuse.ts",
    "test:element-context": "node --use-env-proxy scripts/verify-element-context.ts",
    "test:queue": "node --use-env-proxy scripts/verify-queue.ts",
    "test:model-settings": "node --use-env-proxy scripts/verify-model-settings.ts",
    "test:visual": "node --use-env-proxy scripts/verify-visual-feedback.ts",
    "test:visualizations": "node --use-env-proxy scripts/verify-visualizations.ts",
    "test:tabs:ui": "node --use-env-proxy scripts/verify-workspace-tabs.ts",
    "test:tablet:ui": "node --use-env-proxy scripts/verify-tablet-sidebar.ts",
    "test:sidebar-copy-models:ui": "node --use-env-proxy scripts/verify-sidebar-copy-models.ts",
    "test:renderer-migration:ui": "node --use-env-proxy scripts/verify-renderer-migration.ts",
    "test:renderer-settings:ui": "node --use-env-proxy scripts/verify-renderer-settings.ts",
    "test:renderer-messages:ui": "node --use-env-proxy scripts/verify-renderer-messages.ts",
    "test:terminal:ui": "node --use-env-proxy scripts/verify-terminal.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "katex": "0.19.1",
    "lucide-react": "0.468.0",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.4.299",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "ws": "8.21.3"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "chrome-devtools-mcp": "1.12.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2",
    "typescript": "5.9.3"
  }
}
